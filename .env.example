# ============================================
# Injection Queen - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Option 1: Custom API Backend (recommended for production)
# Your backend API URL (e.g., https://api.injectionqueen.nl)
VITE_API_URL=https://api.injectionqueen.nl

# Option 2: EmailJS Configuration (for email-based bookings)
# Get these from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Option 3: WhatsApp Business API (optional)
# For advanced WhatsApp integration
VITE_WHATSAPP_API_KEY=your_whatsapp_api_key

# Note: WhatsApp phone number is hardcoded in src/services/bookingApi.ts
# Update it there if the business number changes
