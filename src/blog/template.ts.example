/**
 * Blog Post Template
 * 
 * Copy this file to create a new blog post:
 * 1. Copy to: posts/YYYY-MM-DD-hh-mm-your-slug.ts
 * 2. Update all fields below
 * 3. Import and add to registry.ts
 * 
 * The datetime field creates unique URLs like: /blog/2026-02-25-10-00
 */

import { BlogPost } from '../types';

export const post: BlogPost = {
  id: '15', // Increment from highest existing
  slug: 'your-post-slug-here',
