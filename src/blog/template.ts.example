  title: 'Your Dutch Title Here',
  titleEn: 'Your English Title Here',
  excerpt: 'Dutch excerpt (2-3 sentences)',
  excerptEn: 'English excerpt (2-3 sentences)',
  category: 'Botox', // Botox, Fillers, Lipfillers, Skinboosters, etc.
  author: 'Zainab Haidari',
  readTime: '5 min',
  
  // Images
  image: '/images/blog/2026-03-08-your-post-slug/featured.jpg',
  images: [
    '/images/blog/2026-03-08-your-post-slug/featured.jpg',
    '/images/blog/2026-03-08-your-post-slug/image-2.jpg',
